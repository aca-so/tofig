{
  "name": "tofig",
  "version": "0.2.0",
  "description": "Convert HTML (e.g. Claude designs) into native Figma designs or Slides",
  "license": "MIT",
  "bin": {
    "tofig-render": "bin/tofig-render.mjs"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "render": "node bin/tofig-render.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@builder.io/html-to-figma": "^0.0.3",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "*",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  }
}
